{
  "xsappname": "my-python-app",
  "tenant-mode": "dedicated",
  "scopes": [
    { "name": "$XSAPPNAME.Display", "description": "View the app" },
    { "name": "$XSAPPNAME.Admin",   "description": "Use admin functions" }
  ],
  "role-templates": [
    { "name": "Viewer",        "description": "Can view the app",
      "scope-references": ["$XSAPPNAME.Display"] },
    { "name": "Administrator", "description": "Can view and administer the app",
      "scope-references": ["$XSAPPNAME.Display", "$XSAPPNAME.Admin"] }
  ],
  "role-collections": [
    { "name": "MyPythonApp_Viewer", "description": "Viewer access to my-python-app",
      "role-template-references": ["$XSAPPNAME.Viewer"] },
    { "name": "MyPythonApp_Admin",  "description": "Admin access to my-python-app",
      "role-template-references": ["$XSAPPNAME.Administrator"] }
  ],
  "oauth2-configuration": {
    "redirect-uris": ["https://*.cfapps.us10-001.hana.ondemand.com/**"]
  }
}